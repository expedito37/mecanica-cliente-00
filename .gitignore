# ==========================================================
# .gitignore
# Arquivos que o Git NÃO sobe para o GitHub
# ==========================================================

# ---------- Dependências (o pnpm install recria) ----------
node_modules
.pnp
.pnp.js

# ---------- Variáveis de ambiente (podem ter senhas e chaves) ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- Testes ----------
coverage

# ---------- Cache do Turborepo ----------
.turbo

# ---------- Vercel (pasta criada ao fazer deploy pela CLI) ----------
.vercel

# ---------- Arquivos gerados pelo build ----------
.next/
out/
build
dist

# ---------- Gerados pelo TypeScript e pelo Next ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Logs de erro ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Arquivos do sistema operacional ----------
.DS_Store
Thumbs.db

# ---------- Certificados e chaves ----------
*.pem